{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": [
    "./src/lib/zod-config.ts"
  ],
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build && npm run check:headers && npm run db:migrate",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development && npm run check:headers",
    "check:headers": "node scripts/check-build-headers.mjs",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "check:label-drift": "tsx scripts/label-drift-check.ts --check",
    "smoke:sale": "node scripts/sale-smoke.mjs",
    "test": "node scripts/run-tests.mjs",
    "a11y:gate": "node scripts/a11y-gate.mjs",
    "a11y:wcag22": "node scripts/wcag22-checks.mjs",
    "a11y:keyboard": "node scripts/keyboard-journeys.mjs",
    "e2e:smoke": "tsx scripts/e2e/run.mjs search compare export",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lms:scorm": "tsx scripts/lms/build-scorm.ts && node scripts/lms/validate-scorm.mjs dist-lms/firstpass-pairs-scorm12.zip"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "~1.169.4",
    "@tanstack/router-plugin": "^1.168.0",
    "better-auth": "~1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "6.2.15",
    "kysely": "^0.29.8",
    "lucide-react": "^0.510.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.13.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "satori": "^0.63.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
