{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/pair/naltrexone-bupropion-bupropion",
      "destination": "/pair/contrave-bupropion",
      "permanent": true
    },
    {
      "source": "/pair/naltrexone-bupropion-bupropion-xl",
      "destination": "/pair/contrave-bupropion-xl",
      "permanent": true
    },
    {
      "source": "/drug/tmp-smx",
      "destination": "/drug/bactrim",
      "permanent": true
    },
    {
      "source": "/drug/bictegravir-lenacapavir",
      "destination": "/drug/bixlenvo",
      "permanent": true
    },
    {
      "source": "/drug/naltrexone-bupropion",
      "destination": "/drug/contrave",
      "permanent": true
    },
    {
      "source": "/drug/atazanavir-cobicistat",
      "destination": "/drug/evotaz",
      "permanent": true
    },
    {
      "source": "/drug/lopinavir",
      "destination": "/drug/kaletra",
      "permanent": true
    },
    {
      "source": "/drug/glecaprevir-pibrentasvir",
      "destination": "/drug/mavyret",
      "permanent": true
    },
    {
      "source": "/drug/lumacaftor-ivacaftor",
      "destination": "/drug/orkambi",
      "permanent": true
    },
    {
      "source": "/drug/darunavir-cobicistat",
      "destination": "/drug/prezcobix",
      "permanent": true
    },
    {
      "source": "/drug/sofosbuvir-velpatasvir-voxilaprevir",
      "destination": "/drug/vosevi",
      "permanent": true
    },
    {
      "source": "/drug/grazoprevir-elbasvir",
      "destination": "/drug/zepatier",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://grok.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.stripe.com https://grok.com https://*.grok.com https://*.grok.me wss://*.grok.me; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://grok.com https://*.grok.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'self' https://grok.com https://*.grok.com https://*.grok.me; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\" \"https://checkout.stripe.com\"), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
